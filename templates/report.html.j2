<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
{{ font_css|safe }}
:root{
  --font-head:"Barlow Condensed","Arial Narrow",Arial,sans-serif;
  --font-body:"Barlow","Segoe UI",Arial,sans-serif;
  --bg:#ffffff; --surface:#ffffff; --ink:#18212f; --ink-2:#4a5566; --ink-3:#8791a0;
  --line:#e2e6ec; --grid:#e9ecf1; --card-border:#dfe3e9;
  --kv330:#b3261e; --kv132:#1f5fa8; --kv33:#2e7d4f;
  --accent:#b87a23; --bad:#b3261e; --warn:#b87a23;
  --ok-band:rgba(46,125,79,.12); --ok-line:rgba(46,125,79,.35);
  --heat:184,122,35;
}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){
  --bg:#12161d; --surface:#171c24; --ink:#e8ecf2; --ink-2:#b4bcc8; --ink-3:#7d8796;
  --line:#2a313c; --grid:#262d38; --card-border:#2a313c;
  --kv330:#e5645b; --kv132:#6ea3e6; --kv33:#5cb883; --bad:#e5645b; --warn:#d9a24e;
  --ok-band:rgba(92,184,131,.14); --ok-line:rgba(92,184,131,.4); --heat:217,162,78;
}}
:root[data-theme="dark"]{
  --bg:#12161d; --surface:#171c24; --ink:#e8ecf2; --ink-2:#b4bcc8; --ink-3:#7d8796;
  --line:#2a313c; --grid:#262d38; --card-border:#2a313c;
  --kv330:#e5645b; --kv132:#6ea3e6; --kv33:#5cb883; --bad:#e5645b; --warn:#d9a24e;
  --ok-band:rgba(92,184,131,.14); --ok-line:rgba(92,184,131,.4); --heat:217,162,78;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.6 var(--font-body);-webkit-font-smoothing:antialiased}
nav.toc{position:sticky;top:0;z-index:5;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(6px);border-bottom:1px solid var(--line)}
nav.toc div{max-width:880px;margin:0 auto;padding:10px 16px;display:flex;gap:22px;overflow-x:auto;white-space:nowrap;scrollbar-width:none}
nav.toc a{color:var(--ink-2);text-decoration:none;font-weight:500;font-size:15px}
nav.toc a:hover{color:var(--ink)}
main{max-width:880px;margin:0 auto;padding:56px 16px 80px}
h1,h2,h3{font-family:var(--font-head);font-weight:700;letter-spacing:-.005em;line-height:1.1;margin:0}
h1{font-size:clamp(34px,6vw,48px);max-width:14ch}
h2{font-size:clamp(28px,4.4vw,36px);margin-top:8px}
h3{font-size:21px;margin:28px 0 12px}
.lede{font-size:clamp(17px,2.2vw,20px);line-height:1.55;margin:18px 0 12px}
.source{color:var(--ink-3);font-size:14px;line-height:1.55;max-width:66ch}
.k330{color:var(--kv330)}.k132{color:var(--kv132)}.k33{color:var(--kv33)}
section{padding-top:48px;margin-top:48px;border-top:1px solid var(--line)}
section.first{border-top:0;margin-top:24px;padding-top:24px}
section>p{margin:14px 0 20px;max-width:70ch}
.card{background:var(--surface);border:1px solid var(--card-border);border-radius:12px;padding:22px 18px 16px;margin:18px 0}
.card h3{margin-top:0}
.chart{width:100%;height:auto;display:block}
.chart .tick{font:12px var(--font-body);fill:var(--ink-3)}
.chart .cat{font:13px var(--font-body);fill:var(--ink-2)}
.chart .cat.small{font-size:12px}
.chart .val{font:12px var(--font-body);fill:var(--ink-2)}
.chart .axis{font:13px var(--font-body);fill:var(--ink-3)}
.legend{display:flex;flex-wrap:wrap;gap:6px 16px;justify-content:center;margin:10px 0 2px;font-size:13px;color:var(--ink-2)}
.legend i{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:6px;vertical-align:-1px}
.note{color:var(--ink-3);font-size:14px;margin:8px 0 0;max-width:70ch}
.method{border-left:4px solid var(--accent);padding:4px 0 4px 18px;margin:22px 0;max-width:70ch;color:var(--ink-2)}
.method b{color:var(--ink)}
.tablewrap{overflow:auto;max-height:430px}
table{width:100%;border-collapse:collapse;font-size:14.5px}
th{font-weight:600;color:var(--ink-2);text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);position:sticky;top:0;background:var(--surface);vertical-align:bottom}
td{padding:9px 10px;border-bottom:1px solid var(--line);vertical-align:top}
td.n,th.n{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
td .code{display:block;color:var(--ink-3);font-size:13px}
.bad{color:var(--bad);font-weight:600}.hi{color:var(--bad)}.lo{color:var(--kv132)}
.pill{display:inline-block;font-size:12.5px;padding:1px 8px;border-radius:99px;background:color-mix(in srgb,var(--ink-3) 14%,transparent);color:var(--ink-2);white-space:nowrap}
.filter{display:flex;align-items:center;gap:10px;margin:6px 0 10px;font-size:15px}
.filter select{font:inherit;padding:6px 10px;border:1px solid var(--card-border);border-radius:8px;background:var(--surface);color:var(--ink)}
.board{overflow-x:auto;padding-left:12px;padding-right:12px}
.board table{font-size:13.5px;min-width:720px}
.board th{text-align:center;color:var(--ink)}
.board td{text-align:center;white-space:nowrap;font-variant-numeric:tabular-nums;border-bottom:0;padding:11px 6px}
.board td:first-child{text-align:left;color:var(--ink-2);white-space:normal;min-width:150px;padding-left:4px}
.heat{border-radius:6px}
.hm td,.hm th{padding:5px 4px;text-align:center;font-size:12.5px;border:0}
.hm th{position:static}
.hm td:first-child{text-align:left;font-weight:600;color:var(--ink-2);white-space:nowrap}
footer{margin-top:64px;padding-top:20px;border-top:1px solid var(--line);color:var(--ink-3);font-size:13.5px}
footer p{margin:6px 0}

@page{size:A4;margin:14mm 12mm 16mm}
@media print{
  body{font-size:11.5pt;background:#fff;color:#18212f;-webkit-print-color-adjust:exact;print-color-adjust:exact}
  nav.toc,.filter{display:none}
  main{max-width:none;padding:0}
  section{break-before:auto;margin-top:22px;padding-top:22px}
  h2,h3{break-after:avoid}
  .card,.method,tr{break-inside:avoid}
  .card.long{break-inside:auto}
  .tablewrap{max-height:none;overflow:visible}
  .board{overflow:visible}.board table{min-width:0;font-size:8.6pt}
  .board td,.board th{padding:6px 1px}.board td:first-child{min-width:0}.heat{min-width:0!important}
  th{position:static}
  table tr[hidden]{display:table-row}
}
</style>
</head>
<body>
<nav class="toc"><div>
  <a href="#board">Region board</a><a href="#capacity">Availability</a><a href="#loading">Transformer loading</a>
  <a href="#n1">N-1 screen</a><a href="#voltage">Lines &amp; voltage</a><a href="#boundary">Boundary lines</a>
  <a href="#timing">Peak timing</a><a href="#feeders">Feeders</a><a href="#energy">Energy meters</a><a href="#data">Data quality</a>
</div></nav>
<main>
<header>
  <h1>{{ month_label }} load returns from {{ scope }}</h1>
  <p class="lede">{{ text.lede }}</p>
  <p class="source">Source: the regional “Monthly Load Data” workbooks ({{ regions|join(', ') }}) (transformer, feeder and line sheets), reporting month {{ month_label }}.
  Each row is a monthly maximum and minimum, so this review is about extremes and asset condition, not hourly profiles.
  Colour code throughout: <span class="k330">330 kV</span>, <span class="k132">132 kV</span>, <span class="k33">33 kV</span>.</p>
</header>

<section class="first" id="board">
  <h2>Region board</h2>
  <p>One row per question Operations should ask each region. Darker cells need attention first.</p>
  <div class="card board"><table>
    <thead><tr><th></th>{% for r in board_regions %}<th>{{ r }}</th>{% endfor %}</tr></thead>
    <tbody>{% for row in board_rows %}<tr><td>{{ row.label }}</td>{% for c in row.cells %}<td><span class="heat" style="display:inline-block;min-width:46px;padding:3px 5px;white-space:nowrap;background:rgba(var(--heat),{{ c.alpha }})">{{ c.text }}</span></td>{% endfor %}</tr>{% endfor %}</tbody>
  </table></div>
</section>

<section id="capacity">
  <h2>Where capacity is out</h2>
  <p>{{ text.capacity }}</p>
  <div class="card"><h3>Transformers by status</h3>{{ charts.status|safe }}{{ legends.status|safe }}</div>
  <div class="card"><h3>Transformer MVA out of service, faulty or under works</h3>{{ charts.mva_out|safe }}</div>
  <h3>Unavailable transformers</h3>
  <div class="filter"><label for="f-unav">Region</label><select id="f-unav" data-target="t-unav"><option value="">All regions</option>{% for r in regions %}<option>{{ r }}</option>{% endfor %}</select></div>
  <div class="card long"><div class="tablewrap"><table id="t-unav">
    <thead><tr><th>Region</th><th>Substation</th><th>Transformer</th><th class="n">MVA</th><th>Status</th><th>Remark</th></tr></thead>
    <tbody>{% for r in unavailable_rows %}<tr data-region="{{ r.region }}"><td>{{ r.region }}</td><td>{{ r.substation or "" }}</td><td>{{ r.name }}</td><td class="n">{{ r.rating_mva|num0 }}</td><td><span class="pill">{{ r.status }}</span></td><td>{{ r.remarks or "" }}</td></tr>{% endfor %}</tbody>
  </table></div></div>
</section>

<section id="loading">
  <h2>How hard the transformers are working</h2>
  <p>{{ text.loading }}</p>
  <div class="card"><h3>Peak loading band, by region</h3>{{ charts.bands|safe }}{{ legends.bands|safe }}</div>
  <div class="card"><h3>Peak loading against hottest winding temperature</h3>{{ charts.scatter|safe }}{{ legends.scatter|safe }}</div>
  <p class="note">Loading = monthly maximum MW ÷ (nameplate MVA × {{ pf }} power factor). Only transformers with a numeric maximum are included.</p>
  <h3>Most heavily loaded transformers</h3>
  <div class="filter"><label for="f-top">Region</label><select id="f-top" data-target="t-top"><option value="">All regions</option>{% for r in regions %}<option>{{ r }}</option>{% endfor %}</select></div>
  <div class="card long"><div class="tablewrap"><table id="t-top">
    <thead><tr><th>Region</th><th>Substation</th><th>Transformer</th><th class="n">MVA</th><th class="n">Peak MW</th><th class="n">Loading</th><th class="n">Winding °C</th><th class="n">Peak at</th></tr></thead>
    <tbody>{% for r in top_loaded %}<tr data-region="{{ r.region }}"><td>{{ r.region }}</td><td>{{ r.substation }}</td><td>{{ r.name }}</td><td class="n">{{ r.rating_mva|num0 }}</td><td class="n">{{ r.max_mw|num1 }}</td><td class="n {{ 'bad' if r.loading_pct >= 90 else '' }}">{{ r.loading_pct|num0 }}%</td><td class="n">{{ r.hot_temp|num0 }}</td><td class="n">{{ r.max_time or "" }}{% if r.max_date %},<br>{{ r.max_date.day }} {{ r.max_date.strftime('%b') }}{% endif %}</td></tr>{% endfor %}</tbody>
  </table></div></div>
</section>

<section id="n1">
  <h2>Substations that fail an N-1 screen</h2>
  <p>{{ text.n1 }}</p>
  <div class="card">{{ charts.n1|safe }}{{ legends.n1|safe }}</div>
  <div class="method"><b>How this is worked out.</b> For each substation and voltage ratio, the monthly peaks of the in-service transformers are added up and compared with the firm capacity: total MVA minus the largest unit, at {{ pf }} power factor. Adding monthly peaks that may not have happened at the same hour overstates the coincident load, so treat this as a screen that tells engineers where to look, not a finding. Out-of-service units are left out of capacity, which shows risk as the network stood this month.</div>
  <h3>Substations running on a single in-service transformer at that ratio</h3>
  <div class="card long"><div class="tablewrap"><table>
    <thead><tr><th>Region</th><th>Substation</th><th>Ratio (kV)</th><th class="n">MVA</th><th class="n">Peak MW</th><th class="n">Loading</th></tr></thead>
    <tbody>{% for r in single %}<tr><td>{{ r.region }}</td><td>{{ r.substation }}</td><td>{{ r.ratio }}</td><td class="n">{{ r.mva|num0 }}</td><td class="n">{{ r.peak_mw|num1 }}</td><td class="n">{% if r.loading_pct is not none %}{{ r.loading_pct }}%{% endif %}</td></tr>{% endfor %}</tbody>
  </table></div></div>
</section>

<section id="voltage">
  <h2>Line flows and voltages</h2>
  <p>{{ text.voltage }}</p>
  <div class="card"><h3>Highest line flows reported</h3>{{ charts.flows|safe }}</div>
  <div class="card"><h3>Voltage at peak load against voltage at minimum load, 330 kV lines</h3>{{ charts.v330|safe }}{{ legends.regions|safe }}<p class="note">Shaded area: {{ band330 }} (±5%).</p></div>
  <h3>Voltage excursions outside the ±5% (330 kV) / ±10% (132 kV) band</h3>
  <div class="card">{{ charts.exc|safe }}{{ legends.exc|safe }}</div>
  <div class="card long"><div class="tablewrap"><table>
    <thead><tr><th>Region</th><th>Line</th><th class="n">kV</th><th>When</th></tr></thead>
    <tbody>{% for e in excursions %}<tr><td>{{ e.region }}</td><td>{{ e.line }}</td><td class="n {{ 'hi' if e.direction == 'High' else 'lo' }}">{{ e.kv|num1 }}</td><td>{{ e.when }}</td></tr>{% endfor %}</tbody>
  </table></div></div>
  <p class="note">Bands used here are the usual Grid Code normal-operation limits; confirm against the edition NISO now operates to. Readings below 75% or above 130% of nominal were treated as entry errors and left out. Line flows marked ⚠ have MW and amps that cannot both be right at that voltage.</p>
</section>

<section id="boundary">
  <h2>Boundary lines: two regions, two numbers</h2>
  <p>{{ text.boundary }}</p>
  <div class="card long"><div class="tablewrap" style="max-height:none"><table>
    <thead><tr><th>Line</th><th>Region A</th><th class="n">Max MW</th><th>Region B</th><th class="n">Max MW</th><th class="n">Gap</th><th class="n">kV at max<br>(A / B)</th></tr></thead>
    <tbody>{% for b in boundary %}<tr><td>{{ b.line }}<span class="code">{{ b.code }}</span></td><td>{{ b.region_a }}</td><td class="n">{{ b.mw_a|num1 }}</td><td>{{ b.region_b }}</td><td class="n">{{ b.mw_b|num1 }}</td><td class="n {{ 'bad' if b.flag else '' }}">{{ b.gap_mw|num1 }} MW<br>({{ b.gap_pct }}%)</td><td class="n">{{ b.kv_a|num0 }} / {{ b.kv_b|num0 }}</td></tr>{% endfor %}</tbody>
  </table></div></div>
</section>

<section id="timing">
  <h2>When the peak happens</h2>
  <p>{{ text.timing }}</p>
  <div class="card"><h3>Hour of monthly maximum, feeders (count of feeders)</h3>
    <div class="tablewrap" style="max-height:none"><table class="hm"><thead><tr><th></th>{% for h in range(24) %}<th>{{ '%02d'|format(h) }}</th>{% endfor %}</tr></thead>
    <tbody>{% for rg, cells in hour_rows %}<tr><td>{{ rg }}</td>{% for c in cells %}<td style="{{ c.style }}" title="{{ rg }} · {{ c.hour }}:00 · {{ c.n }} feeders">{{ c.n or "" }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div>
  </div>
  <div class="card"><h3>Day of {{ month_name }} on which the monthly maximum was logged</h3>{{ charts.days|safe }}{{ legends.days|safe }}</div>
</section>

<section id="feeders">
  <h2>Feeders</h2>
  <p>{{ text.feeders }}</p>
  <div class="card"><h3>Share of feeders whose monthly minimum fell to 0.2 MW or less</h3>{{ charts.dip|safe }}</div>
  <div class="card"><h3>Spread of feeder peak loads</h3>{{ charts.hist|safe }}</div>
</section>

<section id="energy">
  <h2>Energy meters</h2>
  <p>{{ text.energy }}</p>
  <div class="card"><div class="tablewrap" style="max-height:none"><table>
    <thead><tr><th>Region</th><th class="n">Feeders with reading</th><th class="n">Transformers with reading</th><th class="n">Lines with reading</th></tr></thead>
    <tbody>{% for r in meter_rows %}<tr><td>{{ r.region }}</td>{% for c in r.cells %}<td class="n">{{ c.n }} / {{ c.t }} <span style="color:var(--ink-3)">({{ c.p }}%)</span></td>{% endfor %}</tr>{% endfor %}</tbody>
  </table></div></div>
  {% if energy_table %}
  <h3>Energy used this month (MWh)</h3>
  <div class="card long"><div class="tablewrap">{{ energy_table|safe }}</div></div>
  {% endif %}
</section>

<section id="data">
  <h2>State of the returns</h2>
  <p>{{ text.data }}</p>
  <div class="card"><div class="tablewrap" style="max-height:none"><table>
    <thead><tr><th>Correction made on the way in</th><th class="n">Cells</th></tr></thead>
    <tbody>{% for k, v in problems %}<tr><td>{{ k[0]|upper }}{{ k[1:] }}</td><td class="n">{{ v }}</td></tr>{% endfor %}</tbody>
  </table></div></div>
</section>

<footer>
  <p>Generated {{ generated }} by the Outage Tracker monthly review module. Figures calculated in Python from the uploaded workbooks; {{ narrative_source }}.</p>
  {% for n in notes %}<p>{{ n }}</p>{% endfor %}
  <p>Files: {% for f in files %}{{ f.name }} <span style="opacity:.7">({{ f.sha[:10] }})</span>{% if not loop.last %} · {% endif %}{% endfor %}</p>
</footer>
</main>
<script>
document.querySelectorAll('.filter select').forEach(function(s){
  s.addEventListener('change',function(){
    var t=document.getElementById(s.dataset.target);
    t.querySelectorAll('tbody tr').forEach(function(tr){ tr.hidden = !!s.value && tr.dataset.region!==s.value; });
  });
});
</script>
</body>
</html>
